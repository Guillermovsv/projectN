+const headCache = new WeakMap<string[][], string[][]>();
+
+/** ProjectN: the top of a sprite, down to the shoulders. */
+function headOf(sprite: string[][]): string[][] {
+  let head = headCache.get(sprite);
+  if (!head) {
+    const top = sprite.findIndex((row) => row.some((px) => px !== ''));
+    head = sprite.slice(0, Math.max(top, 0) + 15);
+    headCache.set(sprite, head);
+  }
+  return head;
+}
+
+const SNORE_Z = ['11111', '00010', '00100', '01000', '11111'];
+
+/** ProjectN: three little Zs drifting up from a sleeper. */
+function drawSnore(
+  c: CanvasRenderingContext2D,
+  x: number,
+  y: number,
+  zoom: number,
+  seed: number,
+): void {
+  const now = performance.now() / 2400 + seed * 0.37;
+  c.save();
+  for (let i = 0; i < 3; i++) {
+    const t = (now + i / 3) % 1;
+    const px = Math.max(1, Math.round(zoom * (0.5 + t * 0.5)));
+    const left = Math.round(x + t * 7 * zoom);
+    const top = Math.round(y - t * 14 * zoom);
+    c.globalAlpha = Math.min(1, (1 - t) * 1.6);
+    for (const [colour, off] of [
+      ['#1e1e2e', px / 2],
+      ['#e8f0ff', 0],
+    ] as const) {
+      c.fillStyle = colour;
+      SNORE_Z.forEach((row, r) => {
+        for (let k = 0; k < row.length; k++) {
+          if (row[k] === '1') c.fillRect(left + k * px + off, top + r * px + off, px, px);
+        }
+      });
+    }
+  }
+  c.restore();
+}
