diff --git a/webview-ui/src/office/engine/leisure.ts b/webview-ui/src/office/engine/leisure.ts
new file mode 100644
index 0000000..e4d92b3
--- /dev/null
+++ b/webview-ui/src/office/engine/leisure.ts
@@ -0,0 +1,164 @@
+/**
+ * ProjectN: what an agent does off duty. The host says `play` or `sleep` (`agentLeisure`):
+ * the character walks to a free game or bed and stays there until it has work again.
+ * With nothing free, players wander as usual and sleepers nap in their own chair.
+ */
+
+import { TYPE_FRAME_DURATION_SEC } from '../../constants.js';
+import { findPath, isWalkable } from '../layout/tileMap.js';
+import type {
+  Character,
+  Leisure,
+  LeisureSpot,
+  PlacedFurniture,
+  Seat,
+  TileType as TileTypeVal,
+} from '../types.js';
+import { CharacterState, Direction, TILE_SIZE } from '../types.js';
+
+/** Where a sleeper's feet would be below the bed's top edge, so its head rests on the pillow. */
+const BED_ANCHOR_Y_PX = 25;
+const PLAY_FRAME_SEC = TYPE_FRAME_DURATION_SEC / 2;
+
+/** The games, beds and sofas of a layout. */
+export function leisureSpots(
+  furniture: PlacedFurniture[],
+  seats: Map<string, Seat>,
+  tileMap: TileTypeVal[][],
+  blocked: Set<string>,
+): LeisureSpot[] {
+  const spots: LeisureSpot[] = [];
+  for (const item of furniture) {
+    if (item.type.startsWith('ARCADE') || item.type.startsWith('GAME_TV')) {
+      // Players stand below the machine (two in front of the TV), facing it.
+      const width = item.type.startsWith('GAME_TV') ? 2 : 1;
+      for (let dc = 0; dc < width; dc++) {
+        const col = item.col + dc;
+        const row = item.row + 2;
+        if (!isWalkable(col, row, tileMap, blocked)) continue;
+        spots.push({ id: `${item.uid}:${dc}`, kind: 'play', col, row, dir: Direction.UP });
+      }
+    } else if (item.type.startsWith('BED')) {
+      // Reached from the foot of the bed or either side of it.
+      const foot = [
+        { col: item.col, row: item.row + 2 },
+        { col: item.col - 1, row: item.row + 1 },
+        { col: item.col + 1, row: item.row + 1 },
+      ].find((t) => isWalkable(t.col, t.row, tileMap, blocked));
+      if (!foot) continue;
+      spots.push({
+        id: item.uid,
+        kind: 'bed',
+        ...foot,
+        dir: Direction.DOWN,
+        bed: { x: item.col * TILE_SIZE + TILE_SIZE / 2, y: item.row * TILE_SIZE + BED_ANCHOR_Y_PX },
+      });
+    } else if (item.type.startsWith('SOFA')) {
+      for (const seat of seats.values()) {
+        if (seat.uid !== item.uid && !seat.uid.startsWith(`${item.uid}:`)) continue;
+        spots.push({
+          id: seat.uid,
+          kind: 'sofa',
+          col: seat.seatCol,
+          row: seat.seatRow,
+          dir: seat.facingDir,
+          seatId: seat.uid,
+        });
+      }
+    }
+  }
+  return spots;
+}
+
+/** A free spot for `mode`, beds before sofas, the closest first. */
+export function pickSpot(
+  ch: Character,
+  mode: Leisure,
+  spots: LeisureSpot[],
+  taken: Set<string>,
+  seats: Map<string, Seat>,
+): LeisureSpot | null {
+  const rank = (s: LeisureSpot) =>
+    (s.kind === 'sofa' ? 1000 : 0) + Math.abs(s.col - ch.tileCol) + Math.abs(s.row - ch.tileRow);
+  const free = spots.filter(
+    (s) =>
+      (mode === 'play') === (s.kind === 'play') &&
+      !taken.has(s.id) &&
+      // A sofa someone works from isn't free, unless it's their own.
+      (!s.seatId || s.seatId === ch.seatId || !seats.get(s.seatId)?.assigned),
+  );
+  return free.sort((a, b) => rank(a) - rank(b))[0] ?? null;
+}
+
+/** Leave the spot: from a bed, get up beside it. */
+export function leaveSpot(ch: Character): void {
+  if (ch.state === CharacterState.PLAY || ch.state === CharacterState.SLEEP) {
+    ch.state = CharacterState.IDLE;
+    ch.x = ch.tileCol * TILE_SIZE + TILE_SIZE / 2;
+    ch.y = ch.tileRow * TILE_SIZE + TILE_SIZE / 2;
+    ch.frame = 0;
+    ch.frameTimer = 0;
+    ch.wanderTimer = 0;
+  }
+  ch.spot = null;
+}
+
+/**
+ * One frame of time off at `ch.spot`. Returns false while the ordinary state machine
+ * should run instead (walking is shared with it).
+ */
+export function updateLeisure(
+  ch: Character,
+  dt: number,
+  tileMap: TileTypeVal[][],
+  blocked: Set<string>,
+): boolean {
+  const spot = ch.spot;
+  if (!spot || ch.state === CharacterState.WALK) return false;
+  if (ch.state === CharacterState.PLAY || ch.state === CharacterState.SLEEP) {
+    ch.frameTimer += dt;
+    if (ch.frameTimer >= PLAY_FRAME_SEC) {
+      ch.frameTimer -= PLAY_FRAME_SEC;
+      ch.frame = (ch.frame + 1) % 2;
+    }
+    return true;
+  }
+  if (ch.tileCol !== spot.col || ch.tileRow !== spot.row) {
+    // A sofa's own tile is furniture: open it just for this path.
+    const key = `${spot.col},${spot.row}`;
+    const wasBlocked = blocked.delete(key);
+    const path = findPath(ch.tileCol, ch.tileRow, spot.col, spot.row, tileMap, blocked);
+    if (wasBlocked) blocked.add(key);
+    if (path.length === 0) {
+      ch.spot = null;
+      return false;
+    }
+    ch.path = path;
+    ch.moveProgress = 0;
+    ch.state = CharacterState.WALK;
+    ch.frame = 0;
+    ch.frameTimer = 0;
+    return true;
+  }
+  ch.state = spot.kind === 'play' ? CharacterState.PLAY : CharacterState.SLEEP;
+  ch.dir = spot.dir;
+  if (spot.bed) {
+    ch.x = spot.bed.x;
+    ch.y = spot.bed.y;
+  }
+  ch.frame = 0;
+  ch.frameTimer = 0;
+  ch.bubbleType = null;
+  return true;
+}
+
+/** Nap where it sits: no bed or sofa was free. */
+export function napInChair(ch: Character, seats: Map<string, Seat>): boolean {
+  const seat = ch.seatId ? seats.get(ch.seatId) : undefined;
+  if (!seat || ch.tileCol !== seat.seatCol || ch.tileRow !== seat.seatRow) return false;
+  if (ch.state === CharacterState.WALK) return false;
+  ch.state = CharacterState.SLEEP;
+  ch.dir = seat.facingDir;
+  ch.bubbleType = null;
+  return true;
+}
